# ==============================================================================
# Deep Research Assistant - Environment Configuration
# ==============================================================================

# LLM API Configuration (OpenAI, AI Credits, OpenRouter, DeepSeek, Ollama, etc.)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Search Tool Configuration
# (Optional: If Tavily key is not set, DuckDuckGo web search will be used automatically)
TAVILY_API_KEY=

# MongoDB Database Configuration (Optional - falls back to resilient local storage)
MONGODB_URI=
MONGODB_DB_NAME=deep_research_db

# Authentication Configuration
JWT_SECRET=your-secure-jwt-secret-here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ElevenLabs Text-to-Speech API Configuration (Optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Server Configuration
HOST=0.0.0.0
PORT=8000

# LangSmith Observability & Evaluation (Optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=deep-research-assistant
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
